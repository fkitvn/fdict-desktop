{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FDict",
  "version": "1.0.2",
  "identifier": "vn.fkit.dict",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FDict",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#12161c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "FKit Solutions",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
